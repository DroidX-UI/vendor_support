android_library {

    name: "VendorSupport-preference",

    optimize: {
        enabled: false,
    },

    // Include both Java and Kotlin source files
    srcs: [
        "src/**/*.java",
        "src/**/*.kt"
    ],

    static_libs: [
        "androidx.cardview_cardview",
        "androidx.core_core",
        "androidx.preference_preference",
        "androidx.appcompat_appcompat",
        "androidx.recyclerview_recyclerview",
        "SettingsLibMainSwitchPreference",
        "SettingsLib",
        "kotlin-stdlib", // Add Kotlin standard library
        "kotlinx-coroutines-android"
    ],

    resource_dirs: ["res"]

    // Add Kotlin-specific flags if necessary (usually not needed for basic setup)
    // kotlincflags: [
    //     "-Xjvm-default=all",
    // ],

}
